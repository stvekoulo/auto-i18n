{
  "name": "next-auto-i18n",
  "version": "2.1.0",
  "description": "Internationalisation zéro-mutation pour Next.js App Router : détecte, traduit (DeepL) et installe next-intl sans réécrire votre code.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "next-auto-i18n": "./dist/cli/index.js"
  },
  "sideEffects": false,
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsc",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "LICENSE",
    "DOCUMENTATION.md",
    "MIGRATION.md",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "keywords": [
    "i18n",
    "nextjs",
    "next.js",
    "react",
    "translation",
    "cli",
    "deepl",
    "next-intl",
    "react-i18next",
    "vite",
    "internationalization",
    "localization"
  ],
  "author": "Steven KOULO",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stvekoulo/next-auto-i18n.git"
  },
  "homepage": "https://github.com/stvekoulo/next-auto-i18n#readme",
  "bugs": {
    "url": "https://github.com/stvekoulo/next-auto-i18n/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.1",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "dotenv": "^17.4.2",
    "ts-morph": "^28.0.0"
  },
  "peerDependencies": {
    "i18next": ">=23.0.0",
    "next-intl": ">=3.0.0",
    "react-i18next": ">=14.0.0"
  },
  "peerDependenciesMeta": {
    "next-intl": {
      "optional": true
    },
    "i18next": {
      "optional": true
    },
    "react-i18next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
