{
  "name": "next-auto-i18n",
  "version": "1.1.0",
  "description": "Internationalisation zéro-mutation pour Next.js App Router : détecte, traduit (DeepL) et installe next-intl sans réécrire votre code.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "next-auto-i18n": "./dist/cli/index.js"
  },
  "sideEffects": false,
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsc",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "LICENSE",
    "DOCUMENTATION.md",
    "MIGRATION.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "i18n",
    "nextjs",
    "next.js",
    "react",
    "translation",
    "cli",
    "deepl",
    "next-intl",
    "react-i18next",
    "vite",
    "internationalization",
    "localization"
  ],
  "author": "Steven KOULO",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stvekoulo/next-auto-i18n.git"
  },
  "homepage": "https://github.com/stvekoulo/next-auto-i18n#readme",
  "bugs": {
    "url": "https://github.com/stvekoulo/next-auto-i18n/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "diff": "^9.0.0",
    "dotenv": "^16.4.0",
    "inquirer": "^9.2.0",
    "ora": "^9.3.0",
    "ts-morph": "^22.0.0"
  },
  "peerDependencies": {
    "next-intl": ">=3.0.0",
    "i18next": ">=23.0.0",
    "react-i18next": ">=14.0.0"
  },
  "peerDependenciesMeta": {
    "next-intl": {
      "optional": true
    },
    "i18next": {
      "optional": true
    },
    "react-i18next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.14",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.19.0",
    "vitest": "^4.1.1"
  }
}
